{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Tutor Memory Delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "mastery": {"type": "array", "items": {"$ref": "#/$defs/mastery"}},
    "misconceptions": {"type": "array", "items": {"$ref": "#/$defs/misconception"}},
    "preferences": {"type": "array", "items": {"$ref": "#/$defs/preference"}},
    "profile": {"type": "array", "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "state": {"enum": ["unknown", "exposed", "can_explain", "can_apply", "can_transfer"]},
    "evidence_type": {"enum": ["self_report", "recognition", "recall", "explanation", "application", "transfer", "repeated_success", "contradiction", "explicit_preference"]},
    "strength": {"enum": ["weak", "medium", "strong"]},
    "mastery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "concept", "to", "confidence", "evidence_type", "strength"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "concept": {"type": "string", "minLength": 1},
        "from": {"$ref": "#/$defs/state"},
        "to": {"$ref": "#/$defs/state"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_type": {"$ref": "#/$defs/evidence_type"},
        "strength": {"$ref": "#/$defs/strength"},
        "max_hint_level": {"type": "integer", "minimum": 0, "maximum": 6},
        "verified_at": {"type": "string", "minLength": 1}
      }
    },
    "misconception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "status"],
      "properties": {
        "concept": {"type": "string", "minLength": 1},
        "status": {"enum": ["discovered", "corrected"]}
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "confidence", "evidence_type", "strength"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_type": {"$ref": "#/$defs/evidence_type"},
        "strength": {"$ref": "#/$defs/strength"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "source"],
      "properties": {
        "field": {"enum": ["goals", "interests", "background", "constraints"]},
        "value": {},
        "source": {"const": "explicit_user"}
      }
    }
  }
}
