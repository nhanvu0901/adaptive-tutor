{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Tutor Mastery Domain",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "concepts"],
  "properties": {
    "schema_version": {"const": 1},
    "domain": {"type": "string", "minLength": 1},
    "concepts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/concept"}
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "confidence"],
      "properties": {
        "state": {"enum": ["unknown", "exposed", "can_explain", "can_apply", "can_transfer"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "last_verified": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strongest_type", "count"],
          "properties": {
            "strongest_type": {"$ref": "#/$defs/evidence_type"},
            "count": {"type": "integer", "minimum": 0},
            "max_hint_level": {"type": "integer", "minimum": 0, "maximum": 6}
          }
        }
      }
    },
    "evidence_type": {
      "enum": ["self_report", "recognition", "recall", "explanation", "application", "transfer", "repeated_success", "contradiction", "explicit_preference"]
    }
  }
}
